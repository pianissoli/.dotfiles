# If not running interactively, don't do anything
[[ $- != *i* ]] && return

PS1='[\W]\$ '

alias bt='bluetoothctl'
alias brt='brightnessctl'
alias brtlo='brightnessctl set 20%'
alias brtmd='brightnessctl set 50%'
alias brthi='brightnessctl set 100%'

export N_PREFIX=$HOME/.local/.n
export PATH="$HOME/.config/nvim/nvim-linux-x86_64/bin:$HOME/.local/bin:$N_PREFIX/bin:$PATH"
export EDITOR=$(which nvim)

bind -x '"\C-f":"actions.sh"'
