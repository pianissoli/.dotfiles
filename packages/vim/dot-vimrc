function! FzfFiles()
    let l:tmp = tempname()

    execute 'silent !find . -type f 2>/dev/null | fzf > ' . shellescape(l:tmp)

    redraw!

    if filereadable(l:tmp)
        let l:file = trim(join(readfile(l:tmp)))

        call delete(l:tmp)

        if !empty(l:file)
            execute 'edit ' . fnameescape(l:file)
        endif
    endif
endfunction
command! Files call FzfFiles()
nnoremap <leader>f :Files<CR>

